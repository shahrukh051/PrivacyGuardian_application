<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/bg" android:padding="16dp">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- App header -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:padding="16dp"
            android:background="@drawable/bg_card" android:layout_marginBottom="12dp"
            android:gravity="center_vertical">
            <ImageView android:id="@+id/iv_icon"
                android:layout_width="58dp" android:layout_height="58dp"
                android:scaleType="centerCrop" android:layout_marginEnd="14dp"/>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                <TextView android:id="@+id/tv_name" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="App" android:textColor="@color/text1" android:textSize="18sp" android:textStyle="bold"/>
                <TextView android:id="@+id/tv_pkg" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="pkg" android:textColor="@color/muted" android:textSize="10sp" android:fontFamily="monospace"/>
                <TextView android:id="@+id/tv_cat" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="cat" android:textColor="@color/text2" android:textSize="11sp"/>
            </LinearLayout>
        </LinearLayout>

        <!-- Risk -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:padding="16dp"
            android:background="@drawable/bg_card" android:layout_marginBottom="12dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="PRIVACY RISK SCORE" android:textColor="@color/muted"
                android:textSize="10sp" android:fontFamily="monospace" android:layout_marginBottom="6dp"/>
            <TextView android:id="@+id/tv_risk" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="0 — LOW" android:textSize="24sp" android:textStyle="bold" android:fontFamily="monospace"/>
            <TextView android:id="@+id/tv_risk_desc" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="" android:textColor="@color/text2" android:textSize="12sp"
                android:layout_marginTop="8dp" android:lineSpacingMultiplier="1.4"/>
        </LinearLayout>

        <!-- Permissions Audit -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:padding="16dp"
            android:background="@drawable/bg_card" android:layout_marginBottom="12dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="PERMISSIONS AUDIT" android:textColor="@color/muted"
                android:textSize="10sp" android:fontFamily="monospace" android:layout_marginBottom="14dp"/>

            <!-- Each row: label | status -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="10dp">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:text="📷  Camera" android:textColor="@color/cam" android:textSize="13sp" android:fontFamily="monospace"/>
                <TextView android:id="@+id/tv_camera_status" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="NOT GRANTED" android:textSize="12sp" android:fontFamily="monospace" android:textStyle="bold"/>
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="10dp">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:text="🎙️  Microphone" android:textColor="@color/mic" android:textSize="13sp" android:fontFamily="monospace"/>
                <TextView android:id="@+id/tv_mic_status" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="NOT GRANTED" android:textSize="12sp" android:fontFamily="monospace" android:textStyle="bold"/>
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="10dp">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:text="📍  GPS Location" android:textColor="@color/gps" android:textSize="13sp" android:fontFamily="monospace"/>
                <TextView android:id="@+id/tv_location_status" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="NOT GRANTED" android:textSize="12sp" android:fontFamily="monospace" android:textStyle="bold"/>
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="10dp">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:text="👥  Contacts" android:textColor="@color/contacts" android:textSize="13sp" android:fontFamily="monospace"/>
                <TextView android:id="@+id/tv_contacts_status" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="NOT GRANTED" android:textSize="12sp" android:fontFamily="monospace" android:textStyle="bold"/>
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:text="💾  Storage" android:textColor="@color/storage" android:textSize="13sp" android:fontFamily="monospace"/>
                <TextView android:id="@+id/tv_storage_status" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="NOT GRANTED" android:textSize="12sp" android:fontFamily="monospace" android:textStyle="bold"/>
            </LinearLayout>
        </LinearLayout>

        <!-- Recommendations -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:padding="16dp"
            android:background="@drawable/bg_card" android:layout_marginBottom="16dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="ACTION-ORIENTED RECOMMENDATIONS"
                android:textColor="@color/muted" android:textSize="10sp"
                android:fontFamily="monospace" android:layout_marginBottom="10dp"/>
            <TextView android:id="@+id/tv_recs"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="" android:textColor="@color/text2"
                android:textSize="13sp" android:lineSpacingMultiplier="1.6"/>
        </LinearLayout>

        <!-- Open Settings -->
        <Button android:id="@+id/btn_settings"
            android:layout_width="match_parent" android:layout_height="52dp"
            android:text="@string/open_settings"
            android:textColor="@color/green" android:textSize="13sp"
            android:fontFamily="monospace" android:background="@drawable/bg_green_btn"
            android:layout_marginBottom="20dp"/>

    </LinearLayout>
</ScrollView>