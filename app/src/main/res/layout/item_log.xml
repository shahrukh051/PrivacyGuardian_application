<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="horizontal" android:gravity="center_vertical"
    android:padding="12dp" android:background="@drawable/bg_card"
    android:layout_marginBottom="8dp">

    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_weight="1" android:orientation="vertical">
        <TextView android:id="@+id/tv_log_app"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="App" android:textColor="@color/text1"
            android:textSize="13sp" android:textStyle="bold"/>
        <TextView android:id="@+id/tv_log_sensor"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Sensor" android:textSize="11sp"
            android:fontFamily="monospace" android:layout_marginTop="2dp"/>
    </LinearLayout>

    <TextView android:id="@+id/tv_log_bg"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="BG" android:textColor="@color/critical"
        android:textSize="10sp" android:fontFamily="monospace"
        android:padding="4dp" android:background="@drawable/bg_warn"
        android:layout_marginEnd="8dp"/>

    <TextView android:id="@+id/tv_log_time"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="00:00" android:textColor="@color/muted"
        android:textSize="11sp" android:fontFamily="monospace"/>
</LinearLayout>