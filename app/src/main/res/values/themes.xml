<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.PrivacyGuardian" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/green</item>
        <item name="colorPrimaryVariant">@color/bg</item>
        <item name="colorOnPrimary">@color/bg</item>
        <item name="colorSecondary">@color/green</item>
        <item name="android:colorBackground">@color/bg</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
    </style>
    <style name="Theme.PrivacyGuardian.Splash" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@color/bg</item>
    </style>
    <style name="Theme.PrivacyGuardian.Detail" parent="Theme.MaterialComponents.DayNight">
        <item name="android:colorBackground">@color/bg</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="colorPrimary">@color/green</item>
        <item name="actionBarStyle">@style/DarkActionBar</item>
    </style>
    <style name="DarkActionBar" parent="Widget.AppCompat.ActionBar">
        <item name="android:background">@color/bg</item>
        <item name="titleTextStyle">@style/DarkActionBarTitle</item>
    </style>
    <style name="DarkActionBarTitle" parent="TextAppearance.AppCompat.Widget.ActionBar.Title">
        <item name="android:textColor">@color/text1</item>
    </style>
</resources>